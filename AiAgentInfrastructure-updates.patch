diff --git a/services-biome/README.md b/services-biome/README.md
new file mode 100644
index 0000000..efdbe28
--- /dev/null
+++ b/services-biome/README.md
@@ -0,0 +1,86 @@
+# services-biome — vLLM su L40S, esposto in mTLS
+
+File **deployabili** (non snippet). Il razionale è in `docs/BIOME-L40S.md`,
+la decisione in `docs/adr/0009-mtls-per-biome.md`.
+
+```
+[VM gateway] LiteLLM → stunnel (mTLS client) ──VPN──► nginx :8443 ──► vLLM :8000 (loopback) ──► L40S #0
+```
+
+## Deploy sul server BIOME
+
+```bash
+# 1. certificati step-ca
+sudo install -d certs
+step ca certificate "biome-llm.biome.unibo.it" certs/server.crt certs/server.key
+step ca root certs/step-root.crt
+sudo chmod 600 certs/server.key
+
+# 2. configurazione
+cp .env.example .env && chmod 600 .env && $EDITOR .env   # BIND_IP, HF_TOKEN, VLLM_API_KEY
+
+# 3. avvio (il primo caricamento del modello richiede diversi minuti)
+docker compose up -d
+docker compose logs -f vllm | grep -i "started\|error"
+curl -s localhost:8000/health
+
+# 4. firewall: solo la subnet VPN
+sudo ufw allow from <SUBNET_VPN> to any port 8443 proto tcp
+
+# 5. rinnovo automatico dei certificati (step-ca usa cert a vita breve)
+step ca renew --daemon --exec "docker compose restart nginx" certs/server.crt certs/server.key
+```
+
+## Lato client (nella VM del gateway)
+
+```bash
+step ca certificate "litellm-gateway.jfs" certs/client.crt certs/client.key
+chmod 600 certs/client.key
+# aggiungi al compose della VM il servizio 'biome-tls' con stunnel.conf
+```
+```yaml
+  biome-tls:
+    image: alpine:3.20
+    command: sh -c "apk add --no-cache stunnel && exec stunnel /etc/stunnel/stunnel.conf"
+    volumes:
+      - ../services-biome/stunnel.conf:/etc/stunnel/stunnel.conf:ro
+      - ./certs:/certs:ro
+    restart: unless-stopped
+```
+E in `litellm_config.yaml`:
+```yaml
+  - model_name: biome-coder
+    litellm_params:
+      model: openai/biome-coder
+      api_base: http://biome-tls:8443/v1
+      api_key: os.environ/VLLM_API_KEY
+      timeout: 600
+```
+
+## Verifica — il test che conta
+```bash
+# SENZA certificato client: DEVE fallire
+curl -sk https://biome-llm.biome.unibo.it:8443/v1/models        # atteso: errore handshake
+# CON certificato: 200
+curl -s --cert certs/client.crt --key certs/client.key \
+     --cacert certs/step-root.crt https://biome-llm.biome.unibo.it:8443/v1/models
+# dal gateway
+./scripts/test-all.sh biome
+```
+
+## Failure modes
+| # | Sintomo | Causa | Fix |
+|---|---|---|---|
+| 1 | vLLM crasha all'avvio senza messaggi chiari | shared memory | `shm_size: 16gb` |
+| 2 | OOM al caricamento | `gpu-memory-utilization` troppo alto | 0.90, mai 1.0; riduci `MAX_LEN` |
+| 3 | risposte in blocco invece che streaming | buffering nginx | `proxy_buffering off` |
+| 4 | handshake rifiutato con cert valido | root CA sbagliata | `step ca root` aggiornata |
+| 5 | gateway "giù" senza motivo | cert scaduto | `step ca renew --daemon` |
+| 6 | la VM non raggiunge BIOME | VPN blocca il forwarding da virbr0 | `ip route get`, `ip_forward` |
+| 7 | ricercatori senza GPU | il servizio la occupa in modo residente | **governance**, non tecnica |
+
+## Governance — prima di accendere
+Un servizio LLM **occupa la VRAM in modo residente**, a differenza dei job batch.
+Da concordare con Chiarucci e il gruppo: la GPU 0 è dedicabile stabilmente? chi
+sono gli utenti? L'argomento non è il costo ma la **sovranità del dato** —
+ricerca non pubblicata che non lascia l'infrastruttura di ateneo.
diff --git a/services-biome/docker-compose.yml b/services-biome/docker-compose.yml
new file mode 100644
index 0000000..1c58891
--- /dev/null
+++ b/services-biome/docker-compose.yml
@@ -0,0 +1,69 @@
+# ============================================================
+#  Stack BIOME L40S: vLLM + nginx (mTLS). Gira SUL SERVER BIOME.
+#  vLLM non è mai esposto: solo nginx parla col mondo, e solo in mTLS.
+#  Vedi docs/BIOME-L40S.md e docs/adr/0009-mtls-per-biome.md
+# ============================================================
+services:
+  vllm:
+    image: "vllm/vllm-openai:${VLLM_TAG:-latest}"   # PSE: pinna un digest
+    container_name: biome-vllm
+    restart: unless-stopped
+    # SOLO loopback: nginx è l'unico ingresso.
+    ports: ["127.0.0.1:8000:8000"]
+    env_file: .env
+    environment:
+      HUGGING_FACE_HUB_TOKEN: ${HF_TOKEN}
+      VLLM_API_KEY: ${VLLM_API_KEY}
+    volumes:
+      - hf-cache:/root/.cache/huggingface
+    # ⚠️ senza shm_size adeguato vLLM crasha in modo oscuro
+    shm_size: "16gb"
+    deploy:
+      resources:
+        reservations:
+          devices:
+            - driver: nvidia
+              # SOLO GPU 0: la 1 resta ai workload di ricerca.
+              # L40S non ha NVLink -> tensor-parallel via PCIe costa: evitalo.
+              device_ids: ["${GPU_ID:-0}"]
+              capabilities: [gpu]
+    command:
+      - --model=${MODEL_ID:-Qwen/Qwen3-Coder-Next}
+      - --served-model-name=biome-coder
+      - --quantization=fp8          # Ada: FP8 nativo, meglio di Q4 a pari size
+      - --kv-cache-dtype=fp8        # più contesto nella stessa VRAM
+      - --max-model-len=${MAX_LEN:-131072}
+      - --gpu-memory-utilization=0.90   # mai 1.0: OOM al caricamento
+      - --host=0.0.0.0              # dentro il container; fuori è loopback
+      - --port=8000
+      - --api-key=${VLLM_API_KEY}
+    healthcheck:
+      test: ["CMD-SHELL", "curl -fsS http://localhost:8000/health || exit 1"]
+      interval: 30s
+      timeout: 10s
+      retries: 5
+      start_period: 900s            # il primo caricamento del modello è lungo
+    security_opt: ["no-new-privileges:true"]
+    logging:
+      driver: local
+      options: { max-size: "20m", max-file: "3" }
+
+  nginx:
+    image: nginx:1.27-alpine
+    container_name: biome-nginx
+    restart: unless-stopped
+    # Ascolta SOLO sull'IP interno/VPN, mai su 0.0.0.0.
+    ports: ["${BIND_IP}:8443:8443"]
+    volumes:
+      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
+      - ./certs:/etc/nginx/certs:ro     # server.crt/key + step-root.crt
+    depends_on:
+      vllm: { condition: service_healthy }
+    network_mode: "service:vllm"        # parla a vLLM su 127.0.0.1
+    security_opt: ["no-new-privileges:true"]
+    logging:
+      driver: local
+      options: { max-size: "20m", max-file: "3" }
+
+volumes:
+  hf-cache: {}
diff --git a/services-biome/nginx.conf b/services-biome/nginx.conf
new file mode 100644
index 0000000..55999a2
--- /dev/null
+++ b/services-biome/nginx.conf
@@ -0,0 +1,47 @@
+# nginx davanti a vLLM: TLS 1.3 + mTLS (step-ca) + rate limit.
+# Chi non ha un certificato client valido viene rifiutato durante
+# l'handshake, PRIMA di raggiungere l'applicazione.
+
+limit_req_zone $ssl_client_s_dn zone=llm:10m rate=30r/m;
+
+server {
+    listen 8443 ssl;
+    http2 on;
+    server_name _;
+
+    ssl_certificate     /etc/nginx/certs/server.crt;
+    ssl_certificate_key /etc/nginx/certs/server.key;
+    ssl_protocols TLSv1.3;
+
+    # --- mTLS: solo client con certificato emesso dalla TUA step-ca ---
+    ssl_client_certificate /etc/nginx/certs/step-root.crt;
+    ssl_verify_client on;
+    ssl_verify_depth 2;
+
+    # Il DN del client finisce nei log: audit di chi ha chiamato cosa.
+    log_format mtls '$remote_addr "$ssl_client_s_dn" $status '
+                    '$request_time "$request" $body_bytes_sent';
+    access_log /var/log/nginx/biome-llm.log mtls;
+
+    location /v1/ {
+        limit_req zone=llm burst=10 nodelay;
+
+        proxy_pass http://127.0.0.1:8000;
+        proxy_set_header Host $host;
+        proxy_set_header X-Client-DN $ssl_client_s_dn;
+
+        # --- streaming SSE: senza questi la risposta arriva tutta insieme ---
+        proxy_buffering off;
+        proxy_cache off;
+        chunked_transfer_encoding on;
+
+        # generazioni lunghe
+        proxy_read_timeout 600s;
+        proxy_send_timeout 600s;
+    }
+
+    location /health {
+        proxy_pass http://127.0.0.1:8000/health;
+        access_log off;
+    }
+}
diff --git a/services-biome/stunnel.conf b/services-biome/stunnel.conf
new file mode 100644
index 0000000..186b8d4
--- /dev/null
+++ b/services-biome/stunnel.conf
@@ -0,0 +1,16 @@
+# Sidecar mTLS LATO CLIENT (gira nella VM del gateway, non su BIOME).
+# LiteLLM parla HTTP in locale al sidecar; il sidecar fa mTLS verso BIOME.
+# Scelta PSE: non dipendere dal supporto ai client-cert di LiteLLM, che
+# varia tra versioni.
+foreground = yes
+output = /dev/stdout
+
+[biome-llm]
+client = yes
+accept  = 0.0.0.0:8443                    # LiteLLM chiama qui, in chiaro
+connect = biome-llm.biome.unibo.it:8443   # adatta all'FQDN reale
+cert    = /certs/client.crt               # certificato CLIENT (mTLS)
+key     = /certs/client.key
+CAfile  = /certs/step-root.crt            # valida il server
+verifyChain = yes
+sslVersion = TLSv1.3
-- 

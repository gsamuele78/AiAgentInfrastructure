# services/.env — copia, compila, chmod 600. MAI in git.
LITELLM_IMAGE_TAG=main-stable
# Extra di headroom-ai: vuoto = core. "[all]" tira dentro torch (~3 GB): vedi Dockerfile.
HEADROOM_EXTRAS=
POSTGRES_PASSWORD=CHANGEME-openssl-rand-hex-32
LITELLM_MASTER_KEY=sk-CHANGEME-openssl-rand-hex-32
ANTHROPIC_API_KEY=sk-ant-CHANGEME
OPENROUTER_API_KEY=sk-or-v1-CHANGEME
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
GEMINI_API_KEY=CHANGEME
MISTRAL_API_KEY=CHANGEME
# Lane BIOME (F6): stessa chiave di services-biome/.env (VLLM_API_KEY).
# Deve esistere anche se la lane non e' ancora attiva: LiteLLM risolve
# os.environ/ al boot e una variabile mancante lo fa partire male.
VLLM_API_KEY=CHANGEME-openssl-rand-hex-32

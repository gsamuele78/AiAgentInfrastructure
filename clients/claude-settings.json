{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
    "ANTHROPIC_MODEL": "anthropic-claude",
    "ANTHROPIC_CUSTOM_HEADERS": "x-litellm-api-key: Bearer sk-CHANGEME-virtual-key"
  },
  "permissions": {
    "allow": [
      "Bash(git rm *)",
      "Bash(git add *)",
      "Bash(git grep *)"
    ],
    "ask": [
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm --recursive*)",
      "Bash(rm --force*)",
      "Bash(rm * -r*)",
      "Bash(rm * -fr*)",
      "Bash(sudo rm *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(dd * of=/dev/*)",
      "Bash(dd of=/dev/*)",
      "Bash(sudo dd *)",
      "Bash(mkfs*)",
      "Bash(sudo mkfs*)",
      "Bash(wipefs *)",
      "Bash(* > /dev/sd*)",
      "Bash(* > /dev/nvme*)",
      "Bash(bash)",
      "Bash(sh)",
      "Bash(zsh)",
      "Bash(node)",
      "Bash(python3 -)",
      "Bash(python -)",
      "Bash(bash -s*)",
      "Bash(sh -s*)",
      "Bash(sudo bash)",
      "Bash(sudo sh)",
      "Bash(eval *)",
      "Bash(bash -c *rm -*)",
      "Bash(sh -c *rm -*)",
      "Bash(python* -c *rmtree*)",
      "Bash(python* -c *os.system*)",
      "Bash(python* -c *subprocess*)",
      "Bash(perl -e *system*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(git branch -D *)",
      "Bash(docker compose*down*-v*)",
      "Bash(docker compose*down*--volumes*)",
      "Bash(docker-compose*down*-v*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(virsh destroy *)",
      "Bash(virsh undefine *)",
      "Bash(virsh vol-delete *)",
      "Bash(virsh snapshot-delete *)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP TABLE*)",
      "Bash(*TRUNCATE *)",
      "Bash(chmod -R 777 *)",
      "Bash(sudo chown -R *)",
      "Bash(rpm-ostree reset*)",
      "Bash(rpm-ostree rebase *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(chmod -R 777 /)"
    ]
  }
}

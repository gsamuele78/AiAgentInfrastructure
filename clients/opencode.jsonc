{
  // ~/.config/opencode/opencode.jsonc — un solo provider verso il gateway.
  // `auto` = catena locale -> Anthropic (API key) -> OpenRouter, decisa nel
  // gateway (ADR-0016). opencode NON usa l'abbonamento Claude: i termini lo
  // limitano a Claude Code e claude.ai (CLAUDE-SUBSCRIPTION.md).
  "$schema": "./opencode.schema.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://127.0.0.1:4000/v1", "apiKey": "{env:LITELLM_MASTER_KEY}" },
      "models": {
        // limit = quello del modello PIU' GRANDE della catena: e' il gateway a
        // mandare al cloud i prompt che non entrano nel locale. Con il limite
        // del locale opencode compatterebbe a 12k anche quando risponde Claude.
        "auto":            { "limit": { "context": 200000, "output": 32000 } },
        "coding": {}, "smart": {}, "cheap": {},
        "claude-opus-4-8": { "limit": { "context": 200000, "output": 32000 } },
        "or-private": {},
        "local-good":      { "limit": { "context": 12288, "output": 4096 } }
      }
    }
  },
  "model": "litellm/auto",
  // titoli e riassunti: niente locale qui, deve rispondere anche a Ollama spento.
  "small_model": "litellm/cheap",
  // Compattazione lato client: si somma a headroom (lato gateway), non lo
  // sostituisce. prune toglie gli output di tool vecchi prima di riassumere.
  "compaction": { "auto": true, "prune": true, "reserved": 10000 },
  // ConfirmRisky (ADR-0019 §4, ADR-0025 §4): i comandi distruttivi chiedono conferma.
  // Fonte unica: tests/risk-corpus/rules.py; check.py le misura sul corpus e verifica
  // che coincidano con clients/claude-settings.json. Vince l'ULTIMA regola: deny in fondo.
  "permission": {
    "bash": {
      "rm -r*": "ask",
      "rm -R*": "ask",
      "rm -fr*": "ask",
      "rm -fR*": "ask",
      "rm --recursive*": "ask",
      "rm --force*": "ask",
      "rm * -r*": "ask",
      "rm * -fr*": "ask",
      "sudo rm *": "ask",
      "find * -delete*": "ask",
      "find * -exec rm *": "ask",
      "shred *": "ask",
      "truncate *": "ask",
      "dd * of=/dev/*": "ask",
      "dd of=/dev/*": "ask",
      "sudo dd *": "ask",
      "mkfs*": "ask",
      "sudo mkfs*": "ask",
      "wipefs *": "ask",
      "* > /dev/sd*": "ask",
      "* > /dev/nvme*": "ask",
      "bash": "ask",
      "sh": "ask",
      "zsh": "ask",
      "node": "ask",
      "python3 -": "ask",
      "python -": "ask",
      "bash -s*": "ask",
      "sh -s*": "ask",
      "sudo bash": "ask",
      "sudo sh": "ask",
      "eval *": "ask",
      "bash -c *rm -*": "ask",
      "sh -c *rm -*": "ask",
      "python* -c *rmtree*": "ask",
      "python* -c *os.system*": "ask",
      "python* -c *subprocess*": "ask",
      "perl -e *system*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push * --force*": "ask",
      "git push * -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -*f*": "ask",
      "git branch -D *": "ask",
      "docker compose*down*-v*": "ask",
      "docker compose*down*--volumes*": "ask",
      "docker-compose*down*-v*": "ask",
      "docker volume rm *": "ask",
      "docker volume prune*": "ask",
      "docker system prune*": "ask",
      "virsh destroy *": "ask",
      "virsh undefine *": "ask",
      "virsh vol-delete *": "ask",
      "virsh snapshot-delete *": "ask",
      "*DROP DATABASE*": "ask",
      "*DROP TABLE*": "ask",
      "*TRUNCATE *": "ask",
      "chmod -R 777 *": "ask",
      "sudo chown -R *": "ask",
      "rpm-ostree reset*": "ask",
      "rpm-ostree rebase *": "ask",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/": "deny",
      "rm -rf $HOME": "deny",
      "chmod -R 777 /": "deny"
    }
  },
  // Versioni LETTERALI e pinnate: la fonte per Dependabot e' stack/package.json e
  // stack/requirements-tools.txt; test-scripts.sh §3 verifica che coincidano.
  // Serena: uvx col pin esatto (ADR-0022), contesto `ide` (NON `agent`: esporrebbe
  // una shell fuori dalle permission di opencode). Il primo avvio scarica il pacchetto.
  "mcp": {
    "serena": { "type": "local", "command": ["uvx","--from","serena-agent==1.7.0","serena","start-mcp-server","--project-from-cwd","--context","ide","--open-web-dashboard","False"], "enabled": true, "timeout": 60000 },
    "mem":    { "type": "local", "command": ["npx","-y","@modelcontextprotocol/server-memory@2026.8.31"] },
    "reason": { "type": "local", "command": ["npx","-y","@modelcontextprotocol/server-sequential-thinking@2026.8.31"] },
    "fs":     { "type": "local", "command": ["npx","-y","@modelcontextprotocol/server-filesystem@2026.8.31","{env:HOME}/workspace"] },
    "ctx7":   { "type": "local", "command": ["npx","-y","@upstash/context7-mcp@4.1.1"], "environment": { "CONTEXT7_API_KEY": "example-key" } },
    "crawl":  { "type": "local", "command": ["npx","-y","firecrawl-mcp@3.27.3"], "environment": { "FIRECRAWL_API_KEY": "example-key" }, "enabled": true, "timeout": 60000 },
    // build locale da git, fuori da Dependabot: componente non pinnato (stack/components.toml).
    "fetch":  { "type": "local", "command": ["node","{env:HOME}/.local/share/mcp/fetch-mcp/dist/index.js"], "environment": {}, "enabled": true, "timeout": 60000 },
    "tavily": { "type": "local", "command": ["npx","-y","tavily-mcp@0.2.22"], "environment": { "TAVILY_API_KEY": "example-key" }, "enabled": false }
  }
}
